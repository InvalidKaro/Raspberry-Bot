# HomePi automatic phone alerts
# Healthy operation stays silent.
HOMEPI_ALERTS_ENABLED=false

# Number exactly as your SIP provider expects it. E.164 (+49...) is common.
HOMEPI_ALERT_TARGET=
HOMEPI_ALERT_PJSIP_TRUNK=homepi-provider

# Monitoring / anti-spam behavior
HOMEPI_ALERT_CHECK_INTERVAL_SECONDS=30
HOMEPI_ALERT_CONFIRM_SECONDS=90
HOMEPI_ALERT_MIN_INTERVAL_SECONDS=3600
HOMEPI_ALERT_MONITORED_SERVICES=raspberry-bot,raspberry-dashboard,pihole-FTL

# Critical thresholds
HOMEPI_ALERT_TEMP_CRITICAL=80
HOMEPI_ALERT_RAM_CRITICAL=95
HOMEPI_ALERT_DISK_CRITICAL=95

# Asterisk retries if a call cannot be completed.
HOMEPI_ALERT_CALL_MAX_RETRIES=2
HOMEPI_ALERT_CALL_RETRY_SECONDS=60
HOMEPI_ALERT_CALL_WAIT_SECONDS=35

# Interactive assistant mode.
# 1 = acknowledge incident
# 2 = read live system status
# 3 = restart the single affected allowlisted service, when available
# 9 = repeat alert
# 0 = end call
HOMEPI_ALERT_INTERACTIVE=true
HOMEPI_ALERT_ESCALATION_SECONDS=300
HOMEPI_ALERT_MAX_ESCALATIONS=2
HOMEPI_ALERT_ACTION_TIMEOUT_SECONDS=30
HOMEPI_ALERT_RESTARTABLE_SERVICES=raspberry-bot.service,raspberry-dashboard.service,pihole-FTL.service

# Shared spool used by both the HomePi monitor and the Asterisk AGI process.
HOMEPI_ALERT_SHARED_DIR=/var/spool/asterisk/homepi-alerts
HOMEPI_ALERT_AGI_SCRIPT=/usr/local/lib/homepi-alert-agi.py

# Local, offline speech rendering.
HOMEPI_ALERT_VOICE=de
HOMEPI_ALERT_VOICE_SPEED=145
HOMEPI_ALERT_VOICE_PITCH=38
HOMEPI_ALERT_VOICE_AMPLITUDE=135

# Fallback non-interactive audio/spool paths.
HOMEPI_ALERT_AUDIO_DIR=/var/tmp/homepi-alerts
HOMEPI_ALERT_STAGING_DIR=/var/spool/asterisk/.homepi-staging
HOMEPI_ALERT_OUTGOING_DIR=/var/spool/asterisk/outgoing
