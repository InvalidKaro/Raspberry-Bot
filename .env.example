DISCORD_TOKEN=
OWNER_IDS=
DEV_GUILD_ID=
BOT_NAME=Raspberry-Bot
ENVIRONMENT=production
DATABASE_PATH=data/bot.sqlite3
LOG_LEVEL=INFO
DEFAULT_EMBED_COLOR=5793266
SYSTEM_MONITOR_INTERVAL=300
SYSTEM_TEMP_WARNING=70
SYSTEM_TEMP_CRITICAL=80
SYSTEM_RAM_WARNING=80
SYSTEM_DISK_WARNING=85
TRANSCRIPT_MAX_MESSAGES=3000
IMAGE_RENDER_CONCURRENCY=1
PI_LED_PIN=18
PI_LED_ACTIVE_HIGH=true

# Spotify metadata/search integration.
# Client ID + Secret enable server-side track search and richer album metadata.
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=

# Spotify changed playlist access in 2026: reading playlist items requires
# user OAuth for playlists owned by / shared with the authorized account.
# scripts/spotify_setup.py can generate the auth URL and exchange the callback.
SPOTIFY_REFRESH_TOKEN=
SPOTIFY_REDIRECT_URI=http://127.0.0.1:8765/callback
SPOTIFY_MARKET=DE
