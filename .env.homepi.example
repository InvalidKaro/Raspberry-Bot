# HomePi Blackbox / Server Score / Warnzentrale
# NINA/BBK region key (12 digits, Kreis-Ebene). Leave empty until configured.
HOMEPI_WARNING_ARS=
# Optional human-readable label, e.g. "Landkreis ..."
HOMEPI_WARNING_LABEL=
# 1=Minor, 2=Moderate, 3=Severe, 4=Extreme. Severe is the default priority overlay threshold.
HOMEPI_WARNING_ALERT_LEVEL=3

# Collector cadence. Temperature/system samples are persisted every 5 minutes.
HOMEPI_POLL_SECONDS=15
HOMEPI_SAMPLE_SECONDS=300
HOMEPI_WARNING_SECONDS=300
HOMEPI_BLACKBOX_RETENTION_DAYS=365

# Optional override of watched services.
# HOMEPI_WATCH_SERVICES=raspberry-bot.service,raspberry-dashboard.service,raspberry-display.service,raspberry-display2.service,raspberry-meshtastic.service,pihole-FTL.service,tailscaled.service,ssh.service
