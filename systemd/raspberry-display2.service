[Unit]
Description=HomePi second 0.96 OLED (Meshtastic + adaptive fallback)
After=local-fs.target network-online.target raspberry-meshtastic.service
Wants=network-online.target raspberry-meshtastic.service

[Service]
Type=simple
User=stefano
Group=stefano
WorkingDirectory=/home/stefano/services/Raspberry-Bot
Environment=PYTHONUNBUFFERED=1
Environment=DISPLAY2_I2C_BUS=3
Environment=DISPLAY2_I2C_ADDRESS=0x3C
Environment=DISPLAY2_ALLOW_MISSING_HARDWARE=1
Environment=DISPLAY2_HARDWARE_RETRY_SECONDS=20
Environment=DISPLAY2_HEADLESS_PREVIEW=1
EnvironmentFile=-/home/stefano/services/Raspberry-Bot/.env.display2
ExecStartPre=/home/stefano/services/Raspberry-Bot/.venv/bin/python -m display_service.secondary_runtime --check
ExecStart=/home/stefano/services/Raspberry-Bot/.venv/bin/python -m display_service.secondary_runtime
Restart=always
RestartSec=5
TimeoutStopSec=10
Nice=5
PrivateTmp=true
NoNewPrivileges=true

[Install]
WantedBy=multi-user.target
