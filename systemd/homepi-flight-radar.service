[Unit]
Description=HomePi Flight Radar
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=stefano
WorkingDirectory=/home/stefano/services/Raspberry-Bot
Environment=PYTHONUNBUFFERED=1
ExecStart=/home/stefano/services/Raspberry-Bot/.venv/bin/python -m flight_radar.app
Restart=on-failure
RestartSec=3
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=read-only

[Install]
WantedBy=multi-user.target
