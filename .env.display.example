# HomePi 0.96 Blue OLED
DISPLAY_GUILD_ID=1162733312226361454
DISPLAY_DATABASE_PATH=/home/stefano/services/Raspberry-Bot/data/bot.sqlite3
DISPLAY_LOG_LEVEL=INFO
DISPLAY_TIMEZONE=Europe/Berlin

# Deploy-safe defaults: service stays active before the OLED is installed.
DISPLAY_ALLOW_MISSING_HARDWARE=1
DISPLAY_HARDWARE_RETRY_SECONDS=20
DISPLAY_HEADLESS_PREVIEW=1

# Retro head-unit animation. It starts only after a full page carousel has completed
# and at least this interval has passed since the previous animation.
DISPLAY_ANIMATION_ENABLED=1
DISPLAY_ANIMATION_INTERVAL_SECONDS=60
DISPLAY_ANIMATION_DURATION_SECONDS=10
DISPLAY_ANIMATION_FPS=10
# mix | spectrum | scanner | wave | tunnel
DISPLAY_ANIMATION_STYLE=mix

# Optional paths
# DISPLAY_STATUS_PATH=/home/stefano/services/Raspberry-Bot/data/display_status.json
# DISPLAY_PREVIEW_PATH=/home/stefano/services/Raspberry-Bot/data/display_preview.png
