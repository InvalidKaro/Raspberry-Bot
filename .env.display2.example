# HomePi second 0.96 OLED
# Uses a separate software I2C bus so both OLEDs may stay at 0x3C.
DISPLAY2_I2C_BUS=3
DISPLAY2_I2C_ADDRESS=0x3C
DISPLAY2_BRIGHTNESS=90
DISPLAY2_ROTATION=0
DISPLAY2_PAGE_SECONDS=8
DISPLAY2_REFRESH_SECONDS=3
DISPLAY2_MESSAGE_SECONDS=15
DISPLAY2_ALLOW_MISSING_HARDWARE=1
DISPLAY2_HARDWARE_RETRY_SECONDS=20
DISPLAY2_HEADLESS_PREVIEW=1

# Optional paths
# DISPLAY2_STATUS_PATH=/home/stefano/services/Raspberry-Bot/data/display2_status.json
# DISPLAY2_PREVIEW_PATH=/home/stefano/services/Raspberry-Bot/data/display2_preview.png
# MESHTASTIC_STATE_PATH=/home/stefano/services/Raspberry-Bot/data/meshtastic_state.json
